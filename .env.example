# Скопируй в .env и заполни своими значениями:
# cp .env.example .env

# Database
DB_NAME=hardware_store
DB_USER=change_me
DB_PASS=change_me


JWT_SECRET=change_me_to_random_string_min_32_chars

# Admin
ADMIN_USERNAME=admin@store.ru
ADMIN_PASSWORD=change_me

# CORS — разрешённые источники (через запятую, без пробелов вокруг)
# В разработке: http://localhost:5173
# В продакшне: https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
